<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Force the canonical host (no www) to match the URLs used in
    # meta tags / JSON-LD / sitemap.xml
    RewriteCond %{HTTP_HOST} ^www\.bloodstone\.nl$ [NC]
    RewriteRule ^ https://bloodstone.nl%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # HTML: always revalidate so site edits show up immediately
    ExpiresByType text/html "access plus 0 seconds"

    # Audio: cache hard — a track is only ever fetched once per visitor
    ExpiresByType audio/mpeg "access plus 1 year"
    ExpiresByType audio/mp4 "access plus 1 year"

    # Images
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(mp3|m4a|png|jpe?g|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
